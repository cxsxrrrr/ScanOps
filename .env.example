# =============================================================================
# Vigia — Variables de Entorno para Docker
# =============================================================================
# Copia este archivo a .env en la raiz del proyecto y rellena con tus claves:
#   cp .env.example .env
# =============================================================================

# ── Django ───────────────────────────────────────────────────────────
SECRET_KEY=cambia-esta-clave-secreta-en-produccion
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# ── Base de Datos (PostgreSQL) ───────────────────────────────────────
DB_NAME=auditoria_db
DB_USER=postgres
DB_PASSWORD=postgres
# DB_HOST y DB_PORT se configuran automaticamente en docker-compose.yml

# ── Clerk Auth ───────────────────────────────────────────────────────
CLERK_SECRET_KEY=tu-clerk-secret-key
CLERK_PUBLISHABLE_KEY=tu-clerk-publishable-key
CLERK_JWKS_URL=https://tu-dominio.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://tu-dominio.clerk.accounts.dev

# ── Google Gemini (IA) ───────────────────────────────────────────────
GEMINI_API_KEY=tu-gemini-api-key

# ── Resend (Email) ──────────────────────────────────────────────────
RESEND_API_KEY=tu-resend-api-key
RESEND_FROM_EMAIL=noreply@tudominio.com

# ── Stripe (Pagos) ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=tu-stripe-secret-key
STRIPE_WEBHOOK_SECRET=tu-stripe-webhook-secret
STRIPE_PORTAL_CONFIG_ID=tu-stripe-portal-config-id

# ── CORS / Frontend URL ─────────────────────────────────────────────
# En Codespaces, cambiar a la URL publica del puerto 80 (SIN slash final):
#   https://tu-codespace-xxxx-80.app.github.dev
FRONTEND_URL=http://localhost

# ── Frontend (se inyectan en el build de Vite) ──────────────────────
VITE_CLERK_PUBLISHABLE_KEY=tu-clerk-publishable-key
VITE_STRIPE_PUBLISHABLE_KEY=tu-stripe-secret-key
